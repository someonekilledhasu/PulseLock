# PulseLock Environment Variables

# Supabase Credentials (from your Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini API Key (for AI Voice & Prescription Parser)
GEMINI_API_KEY=your_gemini_api_key_here

# Hardware ESP32 Shared Device Secret / ID
PULSELOCK_DEVICE_ID=ESP32_01
